// ============================================================
// Compras & Estoque — Meridian
// Schema Prisma (PostgreSQL)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------- ENUMS ----------------
enum Setor {
  FINANCEIRO
  PCP
  COMPRAS
  ESTOQUE
  CORTE
  EXPEDICAO
  ADMINISTRATIVO
}

enum TipoTecido {
  MALHA
  PLANO
}

// Classificação do artigo no cadastro
enum CategoriaArtigo {
  MALHA
  TECIDO
  AVIAMENTO
  OUTROS
}

enum TipoMalha {
  TUBULAR
  RAMADA
}

enum Unidade {
  M
  KG
  UN
  PC
  CM
}

enum TipoMov {
  ENTRADA
  SAIDA
  RETORNO
  AJUSTE
}

enum NaturezaComponente {
  MATERIAL
  PERSONALIZACAO
  PERIODO
  VALOR
}

enum StatusNf {
  LANCADA
  APROVADA
  RECEBIDA
}

// Etapas do chão de fábrica (fusão futura com o sistema "cronograma")
enum Etapa {
  CORTE
  PERSONALIZACAO
  COSTURA
  ACABAMENTO
}

// ---------------- USUÁRIOS ----------------
model Usuario {
  id         Int      @id @default(autoincrement())
  nome       String
  sobrenome  String   @default("")
  email      String   @default("")
  login      String   @unique
  senha      String   @default("")
  senhaHash  String?
  fotoBase64 String?
  setor      Setor    @default(PCP)
  isMaster   Boolean  @default(false)
  ativo      Boolean  @default(true)
  permLancaPedidos Boolean @default(false)
  permLancaContas  Boolean @default(false)
  permAlteraStatus Boolean @default(false)
  permVeValores    Boolean @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  mensagensEnviadas  Mensagem[] @relation("MsgDe")
  mensagensRecebidas Mensagem[] @relation("MsgPara")
}

model Mensagem {
  id        Int      @id @default(autoincrement())
  deId      Int
  paraId    Int
  de        Usuario  @relation("MsgDe", fields: [deId], references: [id], onDelete: Cascade)
  para      Usuario  @relation("MsgPara", fields: [paraId], references: [id], onDelete: Cascade)
  texto     String
  lida      Boolean  @default(false)
  arquivada Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ---------------- CADASTROS BASE ----------------
// Fornecedor = Fabricante (nome comercial). Pode ter vários CNPJs.
model Fornecedor {
  id        Int      @id @default(autoincrement())
  nome      String   @default("")
  contato   String?
  telefone  String?
  email     String?
  razaoSocial       String?
  nomeFantasia      String?
  inscricaoEstadual String?
  logradouro        String?
  numero            String?
  complemento       String?
  bairro            String?
  municipio         String?
  uf                String?
  cep               String?
  preposto          String?
  telefones         String?
  emailNf           String?
  obs               String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cnpjs   FornecedorCnpj[]
  artigos Artigo[]
  ocs     OrdemCompra[]
  nfs     NotaFiscal[]
}

model FornecedorCnpj {
  id           Int      @id @default(autoincrement())
  fornecedorId Int
  cnpj         String   @unique
  razaoSocial  String?

  fornecedor Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
}

model Artigo {
  id            Int             @id @default(autoincrement())
  categoria     CategoriaArtigo @default(MALHA)
  fornecedorId  Int?
  codigoFornecedor String?
  nfId          Int?
  nome          String
  artigoInterno String?
  codigo        String?
  cor           String?
  // específico de MALHA
  tipoMalha     TipoMalha?
  rendimento    Decimal?        @db.Decimal(14, 3)
  // MALHA e TECIDO
  composicao    String?
  largura       Decimal?        @db.Decimal(10, 3)
  // específico de TECIDO
  gramatura     Decimal?        @db.Decimal(10, 2)
  // específico de AVIAMENTO
  especificacao String?
  unidade       Unidade         @default(M)
  quantidade    Decimal?        @db.Decimal(14, 3)
  dataCompra    DateTime?
  // preço (visível só ao financeiro)
  valorUnitario Decimal?        @db.Decimal(14, 4)
  ativo         Boolean         @default(true)
  criadoPorId   Int?
  alertaVisto   Boolean         @default(false)
  alertaResolvido Boolean       @default(false)
  estoqueMinimoAtivo  Boolean    @default(false)
  estoqueMinimo       Decimal?   @db.Decimal(14, 3)
  abaixoMinimoAvisado Boolean    @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  fornecedor    Fornecedor?     @relation(fields: [fornecedorId], references: [id])
  nf            NotaFiscal?     @relation(fields: [nfId], references: [id])
  ppItemArtigos PpItemArtigo[]
  picItens      PicItem[]
  ocItens       OcItem[]
  nfItens       NfItem[]
  saldos        EstoqueSaldo[]
  movimentacoes EstoqueMovimentacao[]
  fmeItens      FmeItem[]
}

// ---------------- CATÁLOGO DE PEÇAS ----------------
model TipoPeca {
  id          Int              @id @default(autoincrement())
  nome        String           @unique
  componentes ComponentePeca[]
  ppItens     PpItem[]
}

model ComponentePeca {
  id         Int                @id @default(autoincrement())
  tipoPecaId Int
  ordem      Int
  nome       String
  natureza   NaturezaComponente @default(MATERIAL)

  tipoPeca   TipoPeca           @relation(fields: [tipoPecaId], references: [id], onDelete: Cascade)
  parametros PpItemParametro[]

  @@unique([tipoPecaId, ordem])
}

// ---------------- PV / PP ----------------
model Pv {
  id            Int      @id @default(autoincrement())
  numero        String   @unique
  cliente       String
  dataPedido    DateTime?
  arquivoOrigem String?
  status        String   @default("ABERTO")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pps Pp[]
}

model Pp {
  id        Int      @id @default(autoincrement())
  pvId      Int?
  numero    String?  @unique
  status    String   @default("EM_LANCAMENTO")

  clienteNome       String?
  clienteCnpj       String?
  clienteIe         String?
  clienteEndereco   String?
  clienteContato    String?
  oc                String?
  condicaoPagamento String?
  prazoEntrega      String?
  dtDespacho        String?
  tipoPedido        String?
  vendedor          String?
  obs               String?
  valorTotal        Decimal? @db.Decimal(14, 2)
  arquivoPcPdf      String?
  arquivoLancPdf    String?
  arquivoPedidoPdf  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pv    Pv?      @relation(fields: [pvId], references: [id], onDelete: Cascade)
  itens PpItem[]
}

model PpItem {
  id                Int      @id @default(autoincrement())
  ppId              Int
  tipoPecaId        Int?
  tipoPecaNome      String?
  codigo            String?
  descricao         String?
  quantidade        Decimal  @db.Decimal(14, 3)
  valorUnitario     Decimal? @db.Decimal(14, 2)
  valorTotal        Decimal? @db.Decimal(14, 2)
  gradeJson         String?
  parametrosJson    String?
  fotoBase64        String?
  valorTerceirizado Decimal? @db.Decimal(14, 2)
  etapaAtual        Etapa?
  createdAt         DateTime @default(now())

  pp          Pp                 @relation(fields: [ppId], references: [id], onDelete: Cascade)
  tipoPeca    TipoPeca?          @relation(fields: [tipoPecaId], references: [id])
  parametros  PpItemParametro[]
  artigos     PpItemArtigo[]
  picItens    PicItem[]
  estratific  NfEstratificacao[]
  etapas      EtapaMovimento[]
}

// Movimento de uma peça (ou parte dela) por uma etapa de produção.
// Recebe a lógica que hoje vive no cronograma (state.json).
model EtapaMovimento {
  id         Int       @id @default(autoincrement())
  ppItemId   Int
  etapa      Etapa
  quantidade Decimal   @db.Decimal(14, 3)
  entradaEm  DateTime  @default(now())
  saidaEm    DateTime?
  observacao String?

  ppItem PpItem @relation(fields: [ppItemId], references: [id], onDelete: Cascade)
}

model PpItemParametro {
  id           Int      @id @default(autoincrement())
  ppItemId     Int
  componenteId Int
  valorTexto   String?
  createdAt    DateTime @default(now())

  ppItem     PpItem         @relation(fields: [ppItemId], references: [id], onDelete: Cascade)
  componente ComponentePeca @relation(fields: [componenteId], references: [id])
}

// ---------------- BOM / DEMANDA ----------------
model PpItemArtigo {
  id                Int         @id @default(autoincrement())
  ppItemId          Int
  artigoId          Int
  tipoTecido        TipoTecido?
  consumoPorPeca    Decimal?    @db.Decimal(14, 4)
  rendimentoPorPeca Decimal?    @db.Decimal(14, 4)
  demandaCalculada  Decimal?    @db.Decimal(14, 3)
  createdAt         DateTime    @default(now())

  ppItem PpItem @relation(fields: [ppItemId], references: [id], onDelete: Cascade)
  artigo Artigo @relation(fields: [artigoId], references: [id])
}

// ---------------- PIC ----------------
model Pic {
  id        Int       @id @default(autoincrement())
  numero    String    @unique
  data      DateTime  @default(now())
  status    String    @default("ABERTO")
  createdAt DateTime  @default(now())

  itens PicItem[]
}

model PicItem {
  id         Int     @id @default(autoincrement())
  picId      Int
  artigoId   Int
  ppItemId   Int?
  quantidade Decimal @db.Decimal(14, 3)
  atendido   Decimal @default(0) @db.Decimal(14, 3)

  pic        Pic                @relation(fields: [picId], references: [id], onDelete: Cascade)
  artigo     Artigo             @relation(fields: [artigoId], references: [id])
  ppItem     PpItem?            @relation(fields: [ppItemId], references: [id])
  ocItens    OcItem[]
  estratific NfEstratificacao[]
}

// ---------------- OC ----------------
model OrdemCompra {
  id                  Int       @id @default(autoincrement())
  numero              String    @unique
  fornecedorId        Int
  condicaoFaturamento String?
  prazoFabrica        DateTime?
  prazoTransportadora DateTime?
  status              String    @default("ABERTA")
  createdAt           DateTime  @default(now())

  fornecedor Fornecedor @relation(fields: [fornecedorId], references: [id])
  itens      OcItem[]
}

model OcItem {
  id            Int     @id @default(autoincrement())
  ocId          Int
  artigoId      Int
  picItemId     Int?
  quantidade    Decimal @db.Decimal(14, 3)
  valorUnitario Decimal @db.Decimal(14, 4)

  oc      OrdemCompra @relation(fields: [ocId], references: [id], onDelete: Cascade)
  artigo  Artigo      @relation(fields: [artigoId], references: [id])
  picItem PicItem?    @relation(fields: [picItemId], references: [id])
}

// ---------------- NF + ESTRATIFICAÇÃO ----------------
model NotaFiscal {
  id           Int      @id @default(autoincrement())
  numero       String
  chave        String?  @unique
  fornecedorId Int
  arquivoPdf   String?
  arquivoXml   String?
  temPdf       Boolean  @default(false)
  temXml       Boolean  @default(false)
  dataEmissao  DateTime?
  valorTotal   Decimal? @db.Decimal(14, 2)
  status       StatusNf @default(LANCADA)
  modelo       String   @default("NFE")   // NFE | NFSE (serviço: não movimenta estoque)
  finIgnorada  Boolean  @default(false)   // financeiro marcou que não vira conta a pagar
  createdAt    DateTime @default(now())

  titulos       FinTitulo[]

  fornecedor    Fornecedor            @relation(fields: [fornecedorId], references: [id])
  itens         NfItem[]
  movimentacoes EstoqueMovimentacao[]
  saldos        EstoqueSaldo[]
  artigosOrigem Artigo[]
}

model NfItem {
  id            Int      @id @default(autoincrement())
  nfId          Int
  artigoId      Int?
  descricaoNf   String?
  quantidade    Decimal  @db.Decimal(14, 3)
  valorUnitario Decimal? @db.Decimal(14, 4)

  nf          NotaFiscal         @relation(fields: [nfId], references: [id], onDelete: Cascade)
  artigo      Artigo?            @relation(fields: [artigoId], references: [id])
  estratific  NfEstratificacao[]
}

model NfEstratificacao {
  id         Int     @id @default(autoincrement())
  nfItemId   Int
  picItemId  Int?
  ppItemId   Int?
  quantidade Decimal @db.Decimal(14, 3)

  nfItem  NfItem   @relation(fields: [nfItemId], references: [id], onDelete: Cascade)
  picItem PicItem? @relation(fields: [picItemId], references: [id])
  ppItem  PpItem?  @relation(fields: [ppItemId], references: [id])
}

// ---------------- ESTOQUE ----------------
model EnderecoEstoque {
  id       Int    @id @default(autoincrement())
  corredor String
  celula   String

  saldos        EstoqueSaldo[]
  movimentacoes EstoqueMovimentacao[]

  @@unique([corredor, celula])
}

model EstoqueSaldo {
  id         Int     @id @default(autoincrement())
  artigoId   Int
  enderecoId Int?
  saldo      Decimal @default(0) @db.Decimal(14, 3)
  origemNfId Int?

  artigo   Artigo           @relation(fields: [artigoId], references: [id])
  endereco EnderecoEstoque? @relation(fields: [enderecoId], references: [id])
  origemNf NotaFiscal?      @relation(fields: [origemNfId], references: [id])

  @@unique([artigoId, enderecoId, origemNfId])
}

model EstoqueMovimentacao {
  id         Int      @id @default(autoincrement())
  artigoId   Int
  enderecoId Int?
  tipo       TipoMov
  quantidade Decimal  @db.Decimal(14, 3)
  nfId       Int?
  fmeId      Int?
  usuarioId  Int?
  perfil     String?
  observacao String?
  createdAt  DateTime @default(now())

  artigo   Artigo           @relation(fields: [artigoId], references: [id])
  endereco EnderecoEstoque? @relation(fields: [enderecoId], references: [id])
  nf       NotaFiscal?      @relation(fields: [nfId], references: [id])
  fme      Fme?             @relation(fields: [fmeId], references: [id])
}

// ---------------- FME ----------------
model Fme {
  id                 Int      @id @default(autoincrement())
  numero             String   @unique
  setorDemandante    Setor
  responsavelEstoque Int?
  responsavelSetor   String?
  data               DateTime @default(now())
  createdAt          DateTime @default(now())

  itens         FmeItem[]
  movimentacoes EstoqueMovimentacao[]
}

model FmeItem {
  id             Int     @id @default(autoincrement())
  fmeId          Int
  artigoId       Int
  qtdRetirada    Decimal @default(0) @db.Decimal(14, 3)
  qtdDevolvida   Decimal @default(0) @db.Decimal(14, 3)
  solicitaAjuste Boolean @default(false)
  justificativa  String?
  pedidoProducao String?
  nomeItem       String?
  cor            String?
  unidade        String?

  fme    Fme    @relation(fields: [fmeId], references: [id], onDelete: Cascade)
  artigo Artigo @relation(fields: [artigoId], references: [id])
}

model Cliente {
  id                Int      @id @default(autoincrement())
  razaoSocial       String   @default("")
  nomeFantasia      String?
  cnpj              String?  @unique
  inscricaoEstadual String?
  logradouro        String?
  numero            String?
  complemento       String?
  bairro            String?
  municipio         String?
  uf                String?
  cep               String?
  preposto          String?
  telefones         String?
  emailNf           String?
  obs               String?
  ativo             Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  notas ClienteNota[]
}

model ClienteNota {
  id          Int       @id @default(autoincrement())
  clienteId   Int
  chave       String    @unique
  numero      String?
  pedidoVenda String?
  dataEmissao DateTime?
  valorTotal  Float?
  createdAt   DateTime  @default(now())

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
}

// ============================================================
// COMERCIAL — FPP (Ficha de Precificação de Produtos)
// ============================================================

// Banco de dados de parâmetros (rendimentos, golas, corte, embalagem, constantes...).
// Editável só no MODO OS. chave única por tipo+grupo+chave.
model FppParam {
  id        Int      @id @default(autoincrement())
  tipo      String   // MALHA | PLANO | COMUM
  grupo     String   // PECA | GOLA | PUNHO | ELASTICO | FAIXA | EMB_EXT | EMB_INT | CONST
  chave     String   // ex: "CAMISETA MC MALHA", "GOLA RIBANA", "REEMBOLSO_CONSUMO"
  rotulo    String?
  valor     Float    @default(0)
  extra     Json?    // colunas adicionais (ex: {corte, exped, volProp} ou {und, fita})
  ordem     Int      @default(0)
  ativo     Boolean  @default(true)
  updatedAt DateTime @updatedAt

  historico FppParamHist[]

  @@unique([tipo, grupo, chave])
}

// Histórico datado de alterações do padrão (só quando redefine no modo OS).
model FppParamHist {
  id          Int      @id @default(autoincrement())
  paramId     Int
  campo       String   // "valor" ou nome da coluna do extra (ex "corte")
  deNum       Float?
  paraNum     Float?
  deTexto     String?
  paraTexto   String?
  usuarioId   Int?
  usuarioNome String?
  createdAt   DateTime @default(now())

  param FppParam @relation(fields: [paramId], references: [id], onDelete: Cascade)
}

// Ficha de precificação salva (alimenta o CRM).
model Fpp {
  id            Int      @id @default(autoincrement())
  tipo          String   // MALHA | PLANO
  item          String
  nomeComercial String?
  clienteId     Int?
  clienteNome   String?
  negociacao    String?
  qtde          Int?
  condicaoPagamento String?
  leadTime      Int?
  entradas      Json     // todos os inputs escolhidos
  overrides     Json?    // valores alterados só nesta precificação
  resultados    Json     // custos, ROIC, margem, etc
  custoProducao Float?
  custoFinal    Float?
  valorProposto Float?
  margem        Float?
  totalItem     Float?
  criadoPorId   Int?
  criadoPorNome String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ---------------- FINANCEIRO · IMPORTAÇÃO MENSAL ----------------
// Catálogo dos documentos obrigatórios por mês (1 card por tipo).
model FinDocTipo {
  id          Int     @id @default(autoincrement())
  codigo      String  @unique   // ex: BRADESCO_EXTRATO
  banco       String
  documento   String
  descricao   String?
  qtdEsperada Int     @default(1)   // ex: 3 faturas (1 por portador)
  multiplo    Boolean @default(false)
  ordem       Int     @default(0)
  ativo       Boolean @default(true)

  arquivos       FinArquivo[]
  justificativas FinJustificativa[]
}

// Arquivo enviado (PDF em base64 no banco). hash evita duplicidade.
model FinArquivo {
  id             Int      @id @default(autoincrement())
  competencia    String   // AAAA-MM
  tipoId         Int
  nome           String
  tamanho        Int      @default(0)
  hash           String   @unique
  conteudo       String
  senhaPdf       String?  // senha que abriu o PDF (se protegido)
  enviadoPorId   Int?
  enviadoPorNome String?
  createdAt      DateTime @default(now())

  processado     Boolean  @default(false)  // já virou lançamentos
  saldoAnterior  Decimal? @db.Decimal(14, 2)
  itens          Json?    // documentos de detalhamento: itens lidos (fatura, cobrança, folha, iFood…)
  conciliacao    Json?    // resultado da conferência com o extrato
  prova          Json?    // prova real da leitura: lido x totais declarados no próprio PDF

  tipo        FinDocTipo      @relation(fields: [tipoId], references: [id], onDelete: Cascade)
  lancamentos FinLancamento[]

  @@index([competencia])
}

// Justificativa de documento não enviado (ou enviado parcialmente) no mês.
model FinJustificativa {
  id          Int      @id @default(autoincrement())
  competencia String
  tipoId      Int
  texto       String
  usuarioId   Int?
  usuarioNome String?
  updatedAt   DateTime @updatedAt

  tipo FinDocTipo @relation(fields: [tipoId], references: [id], onDelete: Cascade)

  @@unique([competencia, tipoId])
}

// Senhas de PDF (ex.: fatura C6). Testadas automaticamente no upload.
model FinSenhaPdf {
  id        Int      @id @default(autoincrement())
  rotulo    String
  senha     String
  createdAt DateTime @default(now())
}

// Plano de contas (conta-caixa). 1xxxxxx receita · 2xxxxxx despesa · 3xxxxxx conciliação
model FinConta {
  id        Int      @id @default(autoincrement())
  codigo    String   @unique
  nome      String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  lancamentos FinLancamento[]
  regras      FinRegra[]
}

// Palavra-chave → conta-caixa (identificação automática). Ordem = prioridade: a 1ª que casar vence.
model FinRegra {
  id            Int      @id @default(autoincrement())
  ordem         Int      @default(0)
  descricao     String?
  comparar      String   @default("CONTEM")  // CONTEM | INICIA | TERMINA | IGUAL
  termo         String   // palavras-chave; várias separadas por ";"
  campo         String   @default("TODOS")   // TODOS | HISTORICO | IDENTIFICACAO
  banco         String?  // vazio = todos os bancos
  dc            String?  // D = só saídas · C = só entradas · vazio = ambos
  contaId       Int
  ativo         Boolean  @default(true)
  origem        String   @default("MANUAL")  // BASE (sistema anterior) | MANUAL
  usos          Int      @default(0)
  criadoPorNome String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  conta FinConta @relation(fields: [contaId], references: [id], onDelete: Cascade)
}

// Lançamento financeiro (vem dos extratos/faturas ou manual)
model FinLancamento {
  id                Int      @id @default(autoincrement())
  competencia       String
  arquivoId         Int?
  banco             String
  data              DateTime @db.Date
  historico         String
  documento         String?
  identificacao     String?
  valor             Decimal  @db.Decimal(14, 2)
  contaId           Int?
  regraId           Int?
  origem            String   @default("EXTRATO") // EXTRATO | MANUAL | PARTE | DETALHE
  paiId             Int?     // parte de um lançamento desmembrado
  desmembrado       Boolean  @default(false)    // original oculto, substituído pelas partes
  grupo             String?  // lançamento de DETALHAMENTO: chave do grupo conciliado
  substituido       Boolean  @default(false)    // consolidado do extrato trocado pelo detalhamento
  substGrupo        String?  // grupo que substituiu este consolidado
  revisado          Boolean  @default(false)    // crítica "consolidado sem detalhamento" conferida à mão
  ordem             Int      @default(0)
  identificadoPor   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  arquivo FinArquivo? @relation(fields: [arquivoId], references: [id], onDelete: Cascade)
  conta   FinConta?   @relation(fields: [contaId], references: [id], onDelete: SetNull)

  @@index([competencia])
}

// Resultado da pesquisa da IA na internet para históricos sem precedente (evita pesquisar e pagar de novo)
model FinPesquisa {
  id          Int      @id @default(autoincrement())
  chave       String   @unique   // sinal|histórico normalizado
  historico   String
  achado      String?            // o que a IA descobriu (ramo, empresa…)
  contaCodigo String?
  confianca   String?
  motivo      String?
  termo       String?
  createdAt   DateTime @default(now())
}

// Análises de IA salvas por mês (reabrir sem gastar uma nova análise)
model FinAnaliseIA {
  id          Int      @id @default(autoincrement())
  competencia String
  usuarioNome String?
  ia          Boolean  @default(false)
  nSugestoes  Int      @default(0)
  nIncong     Int      @default(0)
  resultado   Json
  ignorados   Json?    // incongruências marcadas como "ignorar"
  createdAt   DateTime @default(now())

  @@index([competencia])
}

// Matriz de custos: a oficial e os cenários (simulações). Todo o conteúdo fica em "dados" (JSON) e é
// calculado por lib/matriz.js.
model FinMatriz {
  id           Int      @id @default(autoincrement())
  nome         String
  oficial      Boolean  @default(false)
  dados        Json
  atualizadoPor String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  versoes      FinMatrizVersao[]
}

// Cada gravação guarda uma versão (para conferir e restaurar)
model FinMatrizVersao {
  id          Int       @id @default(autoincrement())
  matrizId    Int
  matriz      FinMatriz @relation(fields: [matrizId], references: [id], onDelete: Cascade)
  dados       Json
  usuarioNome String?
  resumo      String?
  createdAt   DateTime  @default(now())

  @@index([matrizId])
}

// ===== Contas a pagar e a receber =====
// Título = uma conta (uma parcela). Pode ser previsão (ex.: gerada por recorrência) ou real.
model FinTitulo {
  id               Int       @id @default(autoincrement())
  tipo             String    // PAGAR | RECEBER
  titulo           String
  parceiro         String    // fornecedor (pagar) ou cliente (receber)
  documento        String?   // CNPJ/CPF do parceiro (só dígitos)
  numeroDoc        String?   // nº da NF / boleto / parcela
  valor            Decimal   @db.Decimal(14, 2)
  vencimento       DateTime  @db.Date
  competencia      String    // AAAA-MM do vencimento
  previsao         Boolean   @default(false)
  status           String    @default("ABERTO") // ABERTO | PAGO | CANCELADO
  dataPagamento    DateTime? @db.Date
  valorPago        Decimal?  @db.Decimal(14, 2)
  rateio           Json      // [{ contaId, pct }]
  observacao       String?
  forma            String    @default("MANUAL") // MANUAL | NF_XML | EXCEL | RECORRENCIA
  formaPagamento   String?   // PIX | BOLETO | DEBITO_AUTOMATICO | TED | CARTAO | DINHEIRO | CHEQUE
  lancamentoId     Int?      // lançamento do extrato que deu baixa nesta conta
  chaveImport      String?   @unique            // evita importar a mesma NF/parcela duas vezes
  arquivoXml       String?
  recorrenciaId    Int?
  recorrencia      FinRecorrencia? @relation(fields: [recorrenciaId], references: [id], onDelete: SetNull)
  nfId             Int?                         // NF lançada pelo Compras que originou a conta
  nf               NotaFiscal?     @relation(fields: [nfId], references: [id], onDelete: SetNull)
  valorConfirmado  Boolean   @default(false)    // recorrência: valor do mês conferido
  criadoPorId      Int?
  criadoPorNome    String?
  atualizadoPorNome String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([recorrenciaId, competencia])
  @@index([tipo, competencia])
  @@index([tipo, status])
  semanaItens FinSemanaItem[]
  anexos      FinTituloAnexo[]
}

// Arquivos anexados a uma conta a pagar/receber (boleto, NF, comprovante...) — base64 no Postgres
model FinTituloAnexo {
  id            Int       @id @default(autoincrement())
  tituloId      Int
  titulo        FinTitulo @relation(fields: [tituloId], references: [id], onDelete: Cascade)
  nome          String
  mime          String?
  tamanho       Int       @default(0)
  conteudo      String    // base64
  criadoPorNome String?
  createdAt     DateTime  @default(now())

  @@index([tituloId])
}

// Conta recorrente: gera um título (previsão) por mês
model FinRecorrencia {
  id            Int      @id @default(autoincrement())
  tipo          String
  titulo        String
  parceiro      String
  documento     String?
  valor         Decimal  @db.Decimal(14, 2)
  diaVencimento Int
  diaUtil       Boolean  @default(false) // true: vence no N-ésimo dia útil do mês (N = diaVencimento)
  periodicidade Int      @default(1)     // meses entre uma parcela e a seguinte: 1 mensal, 3 trimestral…
  formaPagamento String? // PIX | BOLETO | DEBITO_AUTOMATICO | TED | CARTAO | DINHEIRO | CHEQUE
  rateio        Json
  inicio        String   // AAAA-MM
  fim           String?  // AAAA-MM (vazio = sem fim)
  ativo         Boolean  @default(true)
  observacao    String?
  chaveOrigem   String?  @unique   // ex.: MATRIZ|vidaVegetativa|<item> — evita gerar duas vezes
  criadoPorNome String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  titulos       FinTitulo[]
}

// ---------------- FINANCEIRO · CONTABILIDADE ----------------
// Arquivos do pacote mensal da contabilidade (extratos PDF/OFX, SPED, saídas, NFs de serviço…).
// Os extratos em PDF chegam por cópia automática da Importação mensal.
model FinContabDoc {
  id             Int      @id @default(autoincrement())
  competencia    String   // AAAA-MM
  categoria      String   // EXTRATO | RECEBIMENTOS | SPED | SAIDA_XML | SAIDA_PDF | NFS_TOMADA | OUTRO
  tipoId         Int?     // FinDocTipo do extrato (define o banco)
  banco          String?
  formato        String   // PDF | OFX | XML | XLSX | TXT | ZIP
  nome           String   // nome final no padrão (EXTRATO BRADESCO SET 26 PDF.pdf)
  nomeOriginal   String?
  tamanho        Int      @default(0)
  hash           String
  conteudo       String   // base64
  arquivoId      Int?     // FinArquivo de origem (cópia automática da Importação)
  enviadoPorId   Int?
  enviadoPorNome String?
  createdAt      DateTime @default(now())

  @@index([competencia])
  @@index([competencia, categoria])
}

// E-mail da contabilidade e outros ajustes simples (chave/valor).
model FinConfig {
  chave     String   @id
  valor     String
  updatedAt DateTime @updatedAt
}

// Histórico de envios do pacote por e-mail.
model FinContabEnvio {
  id             Int      @id @default(autoincrement())
  competencia    String
  email          String
  assunto        String?
  arquivos       Int      @default(0)
  tamanho        Int      @default(0)
  status         String   @default("ENVIADO") // ENVIADO | ERRO
  erro           String?
  enviadoPorNome String?
  createdAt      DateTime @default(now())

  @@index([competencia])
}

// Notas de saída lidas dos XMLs enviados na Contabilidade (base do cruzamento NF x recebimento).
model FinNfSaida {
  id          Int      @id @default(autoincrement())
  competencia String
  chave       String   @unique
  numero      String
  serie       String?
  emissao     DateTime @db.Date
  valor       Decimal  @db.Decimal(14, 2)
  destNome    String
  destCnpj    String?
  natureza    String?
  docId       Int?     // FinContabDoc do XML
  createdAt   DateTime @default(now())

  @@index([competencia])
  @@index([numero])
}

// Planilha de recebimentos do mês (editável). Gerada do extrato + cobranças e cruzada com as NFs de saída.
model FinRecebimento {
  id           Int       @id @default(autoincrement())
  competencia  String
  bloco        String    @default("CREDITO") // CREDITO | BOLETO | CONFIRMAR
  ordem        Int       @default(0)
  data         DateTime? @db.Date
  titulo       String?   // PIX | TRANSFERÊNCIA ELETRÔNICA | LIQ COBRANÇA
  valor        Decimal   @db.Decimal(14, 2)
  nf           String?
  nomePagador  String?
  cnpj         String?
  obs          String?
  origem       String    @default("AUTO")   // AUTO | MANUAL | IA
  lancamentoId Int?
  editado      Boolean   @default(false)    // mexido à mão: o gerar não sobrescreve
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([competencia])
}

// ---------------- GESTÃO · KPIs ----------------
// Um registro por mês. Hoje os números são lançados à mão (ou importados do Excel);
// conforme os módulos de pedidos/NF de saída/chão de fábrica nascerem, cada campo passa a ser calculado.
model KpiMes {
  id                   Int      @id @default(autoincrement())
  ano                  Int
  mes                  Int      // 1-12
  vendasValor          Decimal? @db.Decimal(14, 2)
  vendasPecas          Int?
  pecasProduzidas      Int?
  faturamentoValor     Decimal? @db.Decimal(14, 2)
  pecasFaturadas       Int?
  metaVendasValor      Decimal? @db.Decimal(14, 2)
  metaVendasPecas      Int?
  metaPecasProduzidas  Int?
  metaFaturamentoValor Decimal? @db.Decimal(14, 2)
  metaFaturamentoPecas Int?
  metaReceitaValor     Decimal? @db.Decimal(14, 2)
  observacao           String?
  atualizadoPorNome    String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([ano, mes])
  @@index([ano])
}

// Peças vendidas por cliente no mês (histórico importado; depois virá dos pedidos lançados)
// kpi: vendasPecas | vendasValor | pecasProduzidas (faturamento e receita saem direto das NFs e recebimentos)
model KpiVendaCliente {
  id        Int      @id @default(autoincrement())
  ano       Int
  mes       Int
  kpi       String   @default("vendasPecas")
  cliente   String
  pecas     Int      @default(0)
  valor     Decimal? @db.Decimal(14, 2)
  origem    String   @default("HISTORICO")
  createdAt DateTime @default(now())

  @@unique([ano, mes, kpi, cliente])
  @@index([ano, mes, kpi])
}

// Receita recebida por canal/segmento (B2B, LICITAÇÕES, AGENCIADA, DIGITAL, PATRIMONIO…)
model KpiReceita {
  id          Int      @id @default(autoincrement())
  ano         Int
  mes         Int
  segmento    String
  valor       Decimal  @db.Decimal(14, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([ano, mes, segmento])
  @@index([ano])
}

// Metas do ano (as mensais, quando existem, ficam no KpiMes)
model KpiAno {
  ano                 Int      @id
  metaVendas          Decimal? @db.Decimal(14, 2)
  metaFaturamento     Decimal? @db.Decimal(14, 2)
  metaReceita         Decimal? @db.Decimal(14, 2)
  metaPecasFaturadas  Int?
  metaPecasProduzidas Int?
  // margem de contribuição em fração (0.18 = 18%), mesma convenção da Matriz de custos
  metaMargem          Decimal? @db.Decimal(6, 4)
  // linha "SEM NOTA" da planilha: entra no total do ano, mas não pertence a nenhum mês
  semNotaVendas       Decimal? @db.Decimal(14, 2)
  semNotaFaturamento  Decimal? @db.Decimal(14, 2)
  updatedAt           DateTime @updatedAt
}

// ---------------- FINANCEIRO · ALAVANCAGEM E POSIÇÃO DE CRÉDITO ----------------
// Contrato de dívida. PARCELADO/INVESTIMENTO = parcela fixa; MUTUO = juros no mês e capital no vencimento.
// Os campos "...Informado" guardam o que veio da planilha; a tela compara com o cálculo e aponta a diferença.
model FinContrato {
  id                      Int       @id @default(autoincrement())
  tipo                    String    // PARCELADO | MUTUO | INVESTIMENTO
  grupo                   String    // GIRO_LP | MUTUO_GIRO | ARREMATE_W3 | INVESTIMENTO
  nome                    String
  credor                  String?
  capital                 Decimal   @db.Decimal(14, 2)
  entrada                 Decimal?  @db.Decimal(14, 2)
  taxaMensal              Decimal?  @db.Decimal(8, 4)   // % ao mês (1.25 = 1,25%)
  dataContrato            DateTime? @db.Date
  inicioPagamento         DateTime? @db.Date            // 1ª parcela (parcelado/investimento)
  prazoMeses              Int?
  parcela                 Decimal?  @db.Decimal(14, 2)
  vencimentoUnico         DateTime? @db.Date            // mútuo: data do pagamento do capital
  prazoDias               Int?                          // mútuo: dias entre contratação e vencimento

  debitoTotalInformado    Decimal?  @db.Decimal(14, 2)
  parcelasPagasInformadas Int?
  aVencerInformado        Decimal?  @db.Decimal(14, 2)
  pagarAteInformado       DateTime? @db.Date
  valorAPagarInformado    Decimal?  @db.Decimal(14, 2)
  jurosTotaisInformado    Decimal?  @db.Decimal(14, 2)
  jurosMesInformado       Decimal?  @db.Decimal(14, 2)

  parcelasPagas           Int?      // ajuste à mão (antecipação/atraso); vazio = o sistema conta pela data
  ativo                   Boolean   @default(true)
  quitado                 Boolean   @default(false)
  contaCaixa              String?   // código da conta-caixa usada na Matriz/contas a pagar
  naMatriz                Boolean   @default(false)
  observacao              String?
  criadoPorNome           String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([tipo])
  @@index([grupo])
}

// Limites de crédito por banco/produto (posição de crédito).
model FinLimiteCredito {
  id         Int      @id @default(autoincrement())
  banco      String
  produto    String
  limite     Decimal  @db.Decimal(14, 2)
  taxaMensal Decimal? @db.Decimal(8, 4)
  utilizado  Decimal? @db.Decimal(14, 2)   // vazio nos mútuos: o sistema soma os contratos do credor
  ordem      Int      @default(0)
  ativo      Boolean  @default(true)
  observacao String?
  updatedAt  DateTime @updatedAt

  @@unique([banco, produto])
}

// Passivo tributário (bloco de impostos da planilha de alavancagem).
model FinTributo {
  id            Int       @id @default(autoincrement())
  grupo         String    // RFB | PGFN | ESTADUAL | OUTRO
  descricao     String
  valor         Decimal   @db.Decimal(14, 2)
  exigivel      Boolean   @default(true)
  parcelado     Boolean   @default(false)
  parcelaMensal Decimal?  @db.Decimal(14, 2)
  parcelas      Int?      // nº total de parcelas do parcelamento
  parcelasPagas Int?      // ajuste à mão; vazio = conta pela data de início
  inicio        DateTime? @db.Date
  competencia   String?   // AAAA-MM de referência
  observacao    String?
  updatedAt     DateTime  @updatedAt
}

// Pagamento extraordinário (amortização) feito num contrato: abate prazo ou reduz a parcela.
model FinPagamentoExtra {
  id            Int      @id @default(autoincrement())
  contratoId    Int
  data          DateTime @db.Date
  valor         Decimal  @db.Decimal(14, 2)
  modo          String   // PRAZO | PARCELA | MUTUO
  parcelaAntes  Decimal? @db.Decimal(14, 2)
  parcelaDepois Decimal? @db.Decimal(14, 2)
  prazoAntes    Int?
  prazoDepois   Int?
  economia      Decimal? @db.Decimal(14, 2)
  observacao    String?
  criadoPorNome String?
  createdAt     DateTime @default(now())

  @@index([contratoId])
}

// ---------------- FINANCEIRO · DRE GERENCIAL E PAINEL DE PREVISÃO ----------------
// Conta-caixa → grupo da DRE gerencial (01.RECEITA, 02.CMV, …). Sem registro, vale o padrão por código.
model FinDreMapa {
  contaId   Int      @id
  grupo     String
  updatedAt DateTime @updatedAt
}

// Painel de previsão do mês: o que não vem das contas é digitado e fica guardado por competência.
model FinMesPainel {
  competencia       String   @id   // AAAA-MM
  saldoInicial      Decimal? @db.Decimal(14, 2)
  dados             Json           // campos manuais do painel (bancos, pedidos, cenários, info)
  atualizadoPorNome String?
  updatedAt         DateTime @updatedAt
}

// ---------------- PRESTADORES · FREELANCERS E TERCEIRIZADOS ----------------
// Cadastro usado nas contas da semana. O terceirizado precisa de endereço; o freelancer não.
model Prestador {
  id            Int      @id @default(autoincrement())
  tipo          String   // FREELANCER | TERCEIRIZADO
  nome          String
  telefone      String?
  chavePix      String
  servicos      Json     // freelancer: ["COSTURA"] · terceirizado: ["FACCAO:POLO","SERVICO:SILK"]
  capacidade    Int?     // peças por semana
  endereco      String?  // obrigatório no terceirizado
  documento     String?  // CPF/CNPJ (opcional)
  observacao    String?
  ativo         Boolean  @default(true)
  criadoPorNome String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  itens FinSemanaItem[]

  @@unique([tipo, nome])
}

// Uma linha dentro da conta da semana (freelancer, facção ou serviço terceirizado).
model FinSemanaItem {
  id            Int      @id @default(autoincrement())
  tituloId      Int
  grupo         String   // FREELANCER | FACCAO | SERVICO
  prestadorId   Int?
  nome          String   // nome no momento do lançamento
  chavePix      String
  setor         String   // COSTURA, CAMISETA, SILK…
  contaId       Int      // conta-caixa do setor (sempre CMV)
  diaria        Decimal? @db.Decimal(14, 2)   // freelancer
  dias          Int?                          // freelancer
  transporte    Decimal? @db.Decimal(14, 2)   // freelancer: transporte por dia, entra no valor do dia
  custoExtra    Decimal? @db.Decimal(14, 2)   // freelancer: extra do período (exige justificativa)
  justificativa String?                       // obrigatória com custo extra ou pagamento excepcional
  descricao     String?                       // serviço "OUTRO": o que foi feito
  dataRecebimento DateTime? @db.Date          // serviço: quando o serviço chegou
  prazoDias     Int?                          // serviço: prazo negociado, em dias corridos
  vencimentoNegociado DateTime? @db.Date      // recebimento + prazo
  excepcional   Boolean  @default(false)      // pagamento fora da sexta programada
  linhas        Json     @default("[]")       // facção/serviço: [{pedido,item,qtd,unitario,total}]
  valor         Decimal  @db.Decimal(14, 2)
  observacao    String?
  criadoPorNome String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  titulo    FinTitulo  @relation(fields: [tituloId], references: [id], onDelete: Cascade)
  prestador Prestador? @relation(fields: [prestadorId], references: [id])

  @@index([tituloId])
  @@index([prestadorId])
}
